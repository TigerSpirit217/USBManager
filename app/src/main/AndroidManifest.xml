<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <queries>
        <provider android:authorities="io.github.libxposed.service" />
    </queries>

    <permission android:name="com.tiger.usbmanager.permission.MANAGE_ADB_AUTHORIZATIONS"
        android:protectionLevel="signature" />
    <uses-permission android:name="com.tiger.usbmanager.permission.MANAGE_ADB_AUTHORIZATIONS" />
    <permission android:name="com.tiger.usbmanager.permission.CONTROL_USB"
        android:protectionLevel="signature" />
    <uses-permission android:name="com.tiger.usbmanager.permission.CONTROL_USB" />

    <application
        android:name=".UsbManagerApp"
        android:allowBackup="false"
        android:fullBackupOnly="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:supportsRtl="true"
        android:description="@string/xposed_description"
        android:theme="@style/Theme.USBManager"
        tools:targetApi="37">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.UsbAuthenticationActivity"
            android:exported="false" />

        <activity android:name=".ui.GameDndSettingsActivity" android:exported="false" />
        <activity android:name=".ui.AdbAuthorizationsActivity" android:exported="false" />
        <activity android:name=".ui.GameDndAppPickerActivity" android:exported="false" />

        <activity
            android:name=".ui.DefaultUsbConfigActivity"
            android:configChanges="orientation|screenSize"
            android:exported="false"
            android:excludeFromRecents="true"
            android:screenOrientation="behind"
            android:theme="@style/Theme.USBManager.Dialog" />

        <!--
            Chooser dialog launched by the system_server hook when a USB host connects
            and a user decision is required. Exported so system_server (uid 1000) can
            start it across the process boundary.
        -->
        <activity
            android:name=".ui.UsbChooserActivity"
            android:configChanges="orientation|screenSize"
            android:exported="true"
            android:excludeFromRecents="true"
            android:launchMode="singleInstance"
            android:screenOrientation="behind"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:theme="@style/Theme.USBManager.Dialog" />

        <!-- Provider calls authenticate Binder UIDs; custom command broadcasts require the app signature. -->
        <provider
            android:name=".bridge.HostProvider"
            android:authorities="com.tiger.usbmanager.hosts"
            android:exported="true"
            android:grantUriPermissions="false" />

    </application>

</manifest>
