<resources xmlns:tools="http://schemas.android.com/tools" tools:locale="zh">
    <string name="app_name">USB 管理器</string>
    <string name="xposed_description">连接电脑时，选择 USB 模式与调试开关。</string>

    <!-- MainActivity intro -->
    <string name="intro_module_info">当前版本：%1$s</string>
    <string name="intro_start">开始使用</string>
    <string name="intro_section_features">功能说明</string>
    <string name="intro_feature_1">• 自动检测 USB 连接</string>
    <string name="intro_feature_2">• 连接电脑时选择 USB 模式</string>
    <string name="intro_feature_3">• 支持充电、文件传输、图片传输、网络共享和 MIDI</string>
    <string name="intro_feature_4">• 一键开关 USB 调试</string>
    <string name="intro_feature_5">• 连接 OTG 设备时不弹窗</string>
    <string name="intro_feature_6">• 可设置拔线自动关闭调试</string>
    <string name="intro_feature_7">• 在 LSPosed 中查看模块日志</string>
    <string name="intro_section_usage">使用方法</string>
    <string name="intro_usage_1">1. 在 LSPosed 中启用模块，勾选 system 并重启</string>
    <string name="intro_usage_2">2. 确认顶部显示“模块已激活”</string>
    <string name="intro_usage_3">3. 用数据线连接电脑</string>
    <string name="intro_usage_4">4. 选择 USB 模式与调试开关，点击“确定”</string>
    <string name="intro_usage_5">5. 在状态页查看或切换当前模式</string>
    <string name="intro_usage_6">6. 在主页调整默认配置</string>

