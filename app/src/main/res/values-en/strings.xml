<resources>
    <string name="app_name">USB Manager</string>
    <string name="xposed_description">Choose USB mode and debugging settings when connecting to a computer.</string>

    <!-- MainActivity intro -->
    <string name="intro_module_info">Version: %1$s</string>
    <string name="intro_start">Get Started</string>
    <string name="intro_section_features">Features</string>
    <string name="intro_feature_1">• Detect USB connections automatically</string>
    <string name="intro_feature_2">• Shows a USB chooser when connected to a computer</string>
    <string name="intro_feature_3">• Charge, transfer files or photos, share internet, or use MIDI</string>
    <string name="intro_feature_4">• Toggle USB debugging</string>
    <string name="intro_feature_5">• No chooser for OTG devices</string>
    <string name="intro_feature_6">• Optionally turn debugging off on unplug</string>
    <string name="intro_feature_7">• View module logs in LSPosed</string>
    <string name="intro_section_usage">Usage</string>
    <string name="intro_usage_1">1. Enable the module for system in LSPosed and restart</string>
    <string name="intro_usage_2">2. Check that “Module active” appears at the top</string>
    <string name="intro_usage_3">3. Connect a computer with a USB cable</string>
    <string name="intro_usage_4">4. Choose USB mode and debugging, then tap OK</string>
    <string name="intro_usage_5">5. View or change the current mode on Status</string>
    <string name="intro_usage_6">6. Adjust defaults on Home</string>

